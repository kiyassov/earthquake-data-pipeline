# Шаблон переменных окружения. Настоящие значения храним в .env:
#   cp .env.example .env
# и заполняем каждое значение. Если хоть одна переменная пустая,
# docker compose откажется стартовать и назовёт её.

# UID вашего пользователя в Linux, чтобы файлы в ./logs принадлежали вам, а не root.
# Узнать: id -u
AIRFLOW_UID=

# База метаданных Airflow (отдельный контейнер Postgres, наружу не открыт).
# Пароль подставляется в URL подключения, поэтому только буквы и цифры:
#   openssl rand -hex 16
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=airflow

# Ключ шифрования Connections и Variables в базе метаданных.
#   openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=

# Подпись JWT-токенов, которыми компоненты Airflow 3 общаются с API-сервером.
#   openssl rand -hex 32
AIRFLOW_JWT_SECRET=

# Подпись сессий веб-интерфейса.
#   openssl rand -hex 32
AIRFLOW_API_SECRET_KEY=

# Администратор веб-интерфейса, создаётся при первом запуске.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=

# S3-хранилище RustFS: root-ключи, они же логин и пароль веб-консоли.
# Ключ доступа от 3 символов, секрет от 8.
#   openssl rand -hex 10
#   openssl rand -hex 20
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Бакет создаётся автоматически при запуске (сервис rustfs-init).
S3_BUCKET=earthquake-raw

# PostgreSQL для DWH. Пароль только из букв и цифр:
#   openssl rand -hex 16
DWH_DB_USER=dwh
DWH_DB_PASSWORD=
DWH_DB_NAME=dwh
